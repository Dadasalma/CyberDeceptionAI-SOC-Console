# Dashboard
SOC_DATA_DIR=./soc_dashboard/data

# Lab/session settings (documentation-range defaults)
LAB_ATTACKER_IP=192.0.2.10
SESSION_GAP_SECONDS=10

# Wazuh/OpenSearch collector over SSH
WAZUH_SSH_HOST=analyst@192.0.2.30
WAZUH_SSH_KEY=~/.ssh/id_ed25519_wazuh
WAZUH_USER=admin
WAZUH_PASSWORD=change_me
WAZUH_OPENSEARCH_URL=https://localhost:9200
WAZUH_POLL_SECONDS=5

# Conpot action target — disabled by default
CONPOT_SSH_HOST=analyst@192.0.2.20
CONPOT_SSH_KEY=~/.ssh/id_ed25519_conpot
CONPOT_DIR=/opt/conpot
ENABLE_REMOTE_ACTIONS=0

# Pipeline
PIPELINE_POLL_SECONDS=5
